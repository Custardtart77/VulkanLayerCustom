{
    "file_format_version": "1.2.0",
    "layer": {
        "name": "VK_LAYER_custom",
        "type": "GLOBAL",
        "library_path": "@JSON_LIBRARY_PATH@",
        "api_version": "1.4.350",
        "implementation_version": "2",
        "description": "LunarG API Hook layer",
        "introduction": "The API Hook utility layer prints API calls, parameters, and values to the identified output stream.",
        "platforms": [
            "WINDOWS",
            "LINUX",
            "MACOS",
            "ANDROID"
        ],
        "instance_extensions": [
            {
                "name": "VK_EXT_layer_settings",
                "spec_version": "2"
            }
        ],
        "device_extensions": [
            {
                "name": "VK_EXT_tooling_info",
                "spec_version": "1",
                "entrypoints": [
                    "vkGetPhysicalDeviceToolPropertiesEXT"
                ]
            }
        ]
        
    }
}